<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <ui:VisualElement name="TitleImage" style="flex-grow: 1; background-image: url(&quot;project://database/Assets/2Dimage/UIimage/TitleImage.png?fileID=2800000&amp;guid=0e81c4d5543c725469a780265f64c80d&amp;type=3#TitleImage&quot;); width: 100%; height: 100%; position: absolute; -unity-background-image-tint-color: rgb(136, 136, 136); top: -2px; left: 0;"/>
    <ui:VisualElement name="TitleNameTextBackImage" style="flex-grow: 1; position: absolute; background-image: url(&quot;project://database/Assets/2Dimage/UIimage/TitleTextBackImage.png?fileID=21300000&amp;guid=2f2296ceaf77c0943882a788eed3aa85&amp;type=3#TitleTextBackImage&quot;); background-color: rgba(0, 0, 0, 0); width: 85%; height: 40%; align-items: auto; justify-content: flex-start; top: 5%; margin-top: 0%; margin-right: 0%; margin-bottom: 0%; margin-left: 0%; align-self: center; padding-top: 0%; -unity-background-image-tint-color: rgb(255, 255, 255);"/>
    <ui:Button text="" name="CreateRoom" triple-click-selects-line="true" enable-rich-text="true" display-tooltip-when-elided="true" focusable="true" tooltip="マッチングするための部屋を作ります。" selectable="false" style="width: 55%; height: 25%; background-image: url(&quot;project://database/Assets/2Dimage/UIimage/CreateRoom.png?fileID=2800000&amp;guid=1b32e0eea02d51f42ac31cd64d4a9789&amp;type=3#CreateRoom&quot;); align-self: center; background-color: rgba(255, 255, 255, 0); margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0; position: absolute; top: 47%; border-top-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-width: 0; background-size: 100% 150%; -unity-background-image-tint-color: rgb(255, 255, 255);">
        <ui:Label text="チームを作る" name="CreateText" style="position: absolute; width: 100%; height: 100%; margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0; -unity-font-style: bold; font-size: 85px; -unity-font-definition: url(&quot;project://database/Assets/TextMesh%20Pro/Fonts/Stick-Regular.ttf?fileID=12800000&amp;guid=bbab80509104cca429e08bc385981394&amp;type=3#Stick-Regular&quot;); color: rgb(255, 255, 255); -unity-text-outline-width: 1px; -unity-text-outline-color: rgb(0, 0, 0); -unity-background-image-tint-color: rgba(255, 255, 255, 0); background-color: rgba(255, 255, 255, 0);"/>
    </ui:Button>
    <ui:Button text="" name="EnterRoom" focusable="true" tooltip="誰かが作成した部屋に入ります。" style="background-color: rgba(255, 255, 255, 0); background-image: url(&quot;project://database/Assets/2Dimage/UIimage/JoinRoom.png?fileID=2800000&amp;guid=d91eb782857eb654286ed573d8ec3955&amp;type=3#JoinRoom&quot;); align-self: center; width: 55%; height: 25%; margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0; position: absolute; top: 70%; border-top-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-width: 0; background-size: 100% 140%; -unity-background-image-tint-color: rgb(255, 255, 255);">
        <ui:Label text="チームに入る" name="JoinRoom" style="-unity-font-definition: url(&quot;project://database/Assets/TextMesh%20Pro/Fonts/Stick-Regular.ttf?fileID=12800000&amp;guid=bbab80509104cca429e08bc385981394&amp;type=3#Stick-Regular&quot;); margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0; position: absolute; width: 100%; height: 100%; font-size: 85px; -unity-font-style: bold; -unity-text-outline-width: 1px; color: rgb(255, 255, 255); -unity-text-outline-color: rgb(0, 0, 0);"/>
    </ui:Button>
    <ui:VisualElement name="MessageLog" style="flex-grow: 1; position: absolute; background-color: rgba(0, 0, 0, 0.98); width: 60%; height: 45%; align-self: center; top: 8%; align-content: auto; align-items: auto; justify-content: flex-start; border-left-color: rgb(117, 117, 117); border-right-color: rgb(117, 117, 117); border-top-color: rgb(117, 117, 117); border-bottom-color: rgb(117, 117, 117); border-top-width: 10px; border-right-width: 10px; border-bottom-width: 10px; border-left-width: 10px; left: 20%; display: none;">
        <ui:Label text="ルームへの接続に失敗しました。&#10;しばらく待ってから再度お試しください。" name="LogText" style="position: relative; color: rgb(255, 255, 255); -unity-font-style: bold; font-size: 55px; -unity-text-align: middle-center; width: 100%; height: 100%; margin-top: 0; -unity-font-definition: url(&quot;project://database/Assets/TextMesh%20Pro/Fonts/Stick-Regular.ttf?fileID=12800000&amp;guid=bbab80509104cca429e08bc385981394&amp;type=3#Stick-Regular&quot;);"/>
    </ui:VisualElement>
</ui:UXML>
